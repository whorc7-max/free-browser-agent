# Copy this file to .env for local testing. Never commit the real .env file.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
BROWSER_USE_HEADLESS=true
ANONYMIZED_TELEMETRY=false
AGENT_MAX_STEPS=25
RUN_PLAYWRIGHT_SMOKE_TEST=true

# Optional: override the built-in example task.
# AGENT_TASK=Open https://example.com and report the page heading.

